# Copy to .env.local and replace every placeholder locally. Never commit .env.local.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status
# Local Postgres connection. For hosted projects use the private direct/session-pooler URL.
GK_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SESSION_SECRET=replace-with-at-least-64-random-characters
OWNER_DOOR_KEY=replace-with-a-long-unique-secret
DISPATCH_SECRET=replace-with-a-different-long-unique-secret
ALLOWED_ORIGINS=http://localhost:8800,http://127.0.0.1:8800,https://gkfood.store,https://status.gkfood.store,https://app.gkfood.store,https://admin.gkfood.store,https://kitchen.gkfood.store,https://courier.gkfood.store
